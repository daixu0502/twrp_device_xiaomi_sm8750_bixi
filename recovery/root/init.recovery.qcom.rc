on early-init
    # vendor_dlkm is not mapped during first bring-up. Load the matching stock
    # touch stack from the recovery ramdisk in dependency order.
    insmod /vendor/lib/modules/xiaomi_touch.ko
    insmod /vendor/lib/modules/synaptics_tcm2.ko

on init
    # Match the stock recovery's UFS compatibility link and initial panel level.
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    write /sys/class/backlight/panel0-backlight/brightness 200
    write /sys/class/backlight/panel1-backlight/brightness 0
    setprop sys.usb.configfs 1
    setprop sys.usb.config adb
    setprop prepdecrypt.setpatch true
    start vendor.boot-qti
    # Wi-Fi control sockets live in RAM, not on /data. Keep userdata
    # unmountable even after starting wpa_supplicant.
    mkdir /tmp/recovery 0775 root wifi
    mkdir /tmp/recovery/sockets 0770 wifi wifi
    chmod 0755 /system/etc/dhcpcd/dhcpcd-run-hooks

on early-fs
    # Follow the SM8750 thales recovery setup: let WALT recognize recovery and
    # ROM installation workers so they can use the full CPU topology on demand.
    write /proc/sys/walt/sched_lib_name "recovery,magiskboot,Updater,updater,update_engine_sideload"
    write /proc/sys/walt/sched_lib_mask_force 255

on fs
    # Qualcomm's secure listeners require the slot modem trustlets and UFS SSD
    # before the Android 15 HALs can talk to QTEE.
    write /proc/sys/kernel/firmware_config/force_sysfs_fallback 1
    chmod 0660 /dev/smcinvoke
    chown system drmrpc /dev/smcinvoke
    chmod 0660 /dev/qsee_ipc_irq_spss
    chown system drmrpc /dev/qsee_ipc_irq_spss
    chmod 0664 /dev/ion
    chown system system /dev/ion
    wait /dev/block/bootdevice/by-name/ssd 10
    wait /dev/block/bootdevice/by-name/modem${ro.boot.slot_suffix} 10
    mkdir /vendor/firmware_mnt 0755 root shell
    # Android init expects mount flags and the filesystem option list as
    # separate arguments. TWRP's mount_all --early skips this charger fstab
    # entry because it is not tagged first_stage_mount.
    mount vfat /dev/block/bootdevice/by-name/modem${ro.boot.slot_suffix} /vendor/firmware_mnt ro shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337
    mount none /vendor/firmware_mnt /firmware bind
    mkdir /mnt/vendor 0775 shell system
    # Keep the vendor alias isolated. TWRP manages the real persist partition
    # at /persist; mounting it here as well would break unmount/wipe semantics.
    mkdir /mnt/vendor/persist 0775 shell system
    mkdir /tmp/persist 0775 shell system
    mount none /tmp/persist /mnt/vendor/persist bind rec
    install_keyring
    start vendor.qseecomd

on property:vendor.sys.listeners.registered=true
    start vendor.gatekeeper_default

# TWRP publishes this after recovery.fstab has created the logical mapper
# devices and attempted module loading; the coordinator verifies /dev/nq-nci.
on property:twrp.modules.loaded=true
    start bixi.crypto-init

on boot
    # The stock recovery kernel command line initially selects performance.
    # Run bixi's stock Qualcomm post-boot tuning once cpufreq is available so
    # WALT can scale to full speed under load and return to idle frequencies.
    wait /sys/devices/system/cpu/cpufreq/policy0/scaling_governor
    wait /sys/devices/system/cpu/cpufreq/policy6/scaling_governor
    # This imported boot action runs before init's class_start default, hence
    # before /system/bin/recovery opens card0 and becomes DRM master.
    wait /dev/dri/card0 5
    exec_start bixi-cover-display-cleanup
    start odm.post_boot
    write /sys/class/backlight/panel1-backlight/brightness 0
    setprop sys.usb.config adb

# Only the postrecoveryboot hook starts this oneshot service, after TWRP has
# staged vendor modules and established its partition table. A Wi-Fi failure
# cannot hold up init's boot action or block the recovery UI/ADB.
service bixi-wifi-init /system/bin/sh /system/bin/bixi-wifi-init.sh
    user root
    # /firmware is the modem vfat mount (0550 system:system). Without the
    # system group the script's firmware check fails before loading cnss2.
    group root system wifi inet net_admin
    capabilities NET_ADMIN NET_RAW SYS_MODULE CHOWN
    disabled
    oneshot
    seclabel u:r:recovery:s0

on property:twrp.wifi.userspace.ready=true
    start wpa_supplicant

service wpa_supplicant /system/bin/wpa_supplicant -Dnl80211 -iwlan0 -c/system/etc/wifi/wpa_supplicant.conf
    class main
    user root
    group root wifi inet net_admin
    disabled
    oneshot
    seclabel u:r:recovery:s0
    # Stock bixi's Android 15 binary needs the same compatibility shims as
    # the security HALs; keep its seven extra libraries in an isolated path.
    setenv LD_LIBRARY_PATH /vendor/lib64:/system/lib64:/system/lib64/wifi
    setenv LD_PRELOAD /system/lib64/libbinder_ndk-sdk35.so:/system/lib64/libbase-sdk35.so:/vendor/lib64/libcxx-bixi-sdk35.so

service dhcpcd /system/bin/dhcpcd wlan0 -B
    class main
    user root
    group root inet net_admin
    capabilities NET_ADMIN NET_RAW
    disabled
    oneshot
    seclabel u:r:recovery:s0

service bixi-cover-display-cleanup /system/bin/bixi-cover-display-cleanup
    user root
    group root graphics
    disabled
    oneshot
    seclabel u:r:recovery:s0
